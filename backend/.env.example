# Razorpay Test/Sandbox credentials
# Get your test keys from: https://dashboard.razorpay.com/app/keys (select "Test Mode")
# NEVER commit your real .env file — only commit this .env.example with placeholder values.

RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_TEST_KEY_SECRET
